    <string name="perm_unused_restrictions_desc">防止系统因长期未打开而休眠本应用、收回权限</string>

    <!-- 需手动确认的必需项 -->
    <string name="manual_autostart">自启动：允许</string>
    <string name="manual_autostart_desc">允许守护侠被闹钟和开机广播拉起，否则后台被杀后无法到点响铃</string>
    <string name="manual_battery">省电策略：无限制</string>
    <string name="manual_battery_desc">把守护侠的省电策略设为“无限制”，否则锁屏后进程可能被冻结</string>
    <string name="manual_recents_lock">最近任务中加锁</string>
    <string name="manual_recents_lock_desc">在最近任务页把守护侠卡片加锁（多为下拉卡片或长按），防止清理内存时被划掉</string>
    <string name="manual_dial_always">拨打电话：始终允许</string>
    <string name="manual_dial_always_desc">小米请在应用信息→其他权限→拨打电话设为“始终允许”并勾选“记住选择”，否则每次拨号都会弹确认框</string>
    <string name="manual_lockscreen_notify">锁屏通知：允许</string>
    <string name="manual_lockscreen_notify_desc">允许守护侠的通知显示在锁屏上，确认页才能及时弹出</string>
    <string name="oem_title">手机系统设置（小米/vivo 等需手动完成）</string>
    <string name="oem_hint">小米/红米还需：自启动管理允许本应用；省电策略选“无限制”；最近任务里下拉本应用卡片加锁；应用信息→其他权限→后台弹出界面→允许。</string>
